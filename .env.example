# 外网上传目标（150 SQL Server）连接配置
# 用法：复制为 .env 放在 jar 同级目录，deploy.sh 启动时会自动加载
# .env 不入版本库（见 .gitignore）

EXTERNAL_SQL_HOST=127.0.0.1
EXTERNAL_SQL_PORT=1433
EXTERNAL_SQL_USER=sa
EXTERNAL_SQL_PASSWORD=
EXTERNAL_SQL_DATABASE=JournalSystem


# ==== 以下仅本机跑脚本时用，不需要放进服务器的 .env ====

# 部署脚本（auto_deploy.py）的服务器 SSH 密码
# 用法：SSH_PASSWORD='xxx' EXTERNAL_SQL_PASSWORD='xxx' python auto_deploy.py
SSH_PASSWORD=

# DataHub 平台 Mongo 连接串，import-datahub-catalog.py 用它读数据库目录（只读）
# 用法：DEMO_SRC_URI='mongodb://用户:密码@主机:27017/?authSource=admin' \
#         python import-datahub-catalog.py --prod
DEMO_SRC_URI=
